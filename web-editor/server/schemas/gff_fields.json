{
  "utc": {
    "_label": "Creature / NPC",
    "_displayName": ["FirstName", "LastName"],
    "sections": [
      {
        "title": "Identity",
        "fields": [
          { "name": "FirstName", "label": "First name", "kind": "locstring",
            "help": "Display first name shown in-game." },
          { "name": "LastName", "label": "Last name", "kind": "locstring",
            "help": "Display last name shown in-game." },
          { "name": "Tag", "label": "Tag", "kind": "string",
            "help": "Internal tag used by scripts and dialog." },
          { "name": "TemplateResRef", "label": "Template ResRef", "kind": "resref",
            "help": "Base template this creature derives from." },
          { "name": "Conversation", "label": "Conversation file", "kind": "resref",
            "help": "ResRef of the .dlg file used when talking to this creature." },
          { "name": "Description", "label": "Description (StrRef)", "kind": "locstring",
            "help": "Flavor description." }
        ]
      },
      {
        "title": "Appearance",
        "fields": [
          { "name": "Appearance_Type", "label": "Appearance", "kind": "enum",
            "enum": "appearance",
            "help": "Row in appearance.2da — controls model + textures." },
          { "name": "Gender", "label": "Gender", "kind": "enum", "enum": "gender" },
          { "name": "Race", "label": "Race", "kind": "enum", "enum": "race" },
          { "name": "SubRace", "label": "Subrace", "kind": "enum", "enum": "subrace" },
          { "name": "PortraitId", "label": "Portrait ID", "kind": "int",
            "help": "Row in portraits.2da." }
        ]
      },
      {
        "title": "Attributes",
        "fields": [
          { "name": "Str", "label": "Strength", "kind": "int", "min": 3, "max": 50 },
          { "name": "Dex", "label": "Dexterity", "kind": "int", "min": 3, "max": 50 },
          { "name": "Con", "label": "Constitution", "kind": "int", "min": 3, "max": 50 },
          { "name": "Int", "label": "Intelligence", "kind": "int", "min": 3, "max": 50 },
          { "name": "Wis", "label": "Wisdom", "kind": "int", "min": 3, "max": 50 },
          { "name": "Cha", "label": "Charisma", "kind": "int", "min": 3, "max": 50 }
        ]
      },
      {
        "title": "Hit Points & Force",
        "fields": [
          { "name": "HitPoints", "label": "Base HP", "kind": "int", "min": 0, "max": 9999 },
          { "name": "MaxHitPoints", "label": "Max HP (effective)", "kind": "int", "min": 0, "max": 9999 },
          { "name": "CurrentHitPoints", "label": "Current HP", "kind": "int", "min": 0, "max": 9999 },
          { "name": "ForcePoints", "label": "Max Force Points", "kind": "int", "min": 0, "max": 9999 },
          { "name": "CurrentForce", "label": "Current Force Points", "kind": "int", "min": 0, "max": 9999 }
        ]
      },
      {
        "title": "Defenses",
        "fields": [
          { "name": "NaturalAC", "label": "Natural AC bonus", "kind": "int", "min": 0, "max": 50 },
          { "name": "fortbonus", "label": "Fortitude save bonus", "kind": "int", "min": -50, "max": 50 },
          { "name": "refbonus", "label": "Reflex save bonus", "kind": "int", "min": -50, "max": 50 },
          { "name": "willbonus", "label": "Will save bonus", "kind": "int", "min": -50, "max": 50 },
          { "name": "ChallengeRating", "label": "Challenge rating", "kind": "float",
            "help": "Used by XP scaling." }
        ]
      },
      {
        "title": "Experience",
        "fields": [
          { "name": "Experience", "label": "Experience (XP)", "kind": "int", "min": 0, "max": 9999999 }
        ]
      },
      {
        "title": "Behaviour & Faction",
        "fields": [
          { "name": "FactionID", "label": "Faction", "kind": "enum", "enum": "faction",
            "help": "Allegiance — controls who attacks whom." },
          { "name": "GoodEvil", "label": "Alignment (Good ↔ Evil)", "kind": "int",
            "min": 0, "max": 100,
            "help": "0 = pure dark side, 50 = neutral, 100 = pure light side." },
          { "name": "PerceptionRange", "label": "Perception range", "kind": "enum",
            "enum": "perception" },
          { "name": "Plot", "label": "Plot-critical", "kind": "bool",
            "help": "Plot-critical NPCs can't die — they fall unconscious." },
          { "name": "IsImmortal", "label": "Immortal", "kind": "bool" },
          { "name": "Disarmable", "label": "Disarmable", "kind": "bool" },
          { "name": "Interruptable", "label": "Conversation interruptable", "kind": "bool" },
          { "name": "NoPermDeath", "label": "Cannot permanently die", "kind": "bool" },
          { "name": "BodyBag", "label": "Body bag", "kind": "enum", "enum": "bodybag",
            "help": "What corpse type / loot container is left behind." }
        ]
      },
      {
        "title": "Combat",
        "fields": [
          { "name": "WalkRate", "label": "Walk rate", "kind": "int",
            "help": "Row in creaturespeed.2da." },
          { "name": "NoPermDeath", "label": "Never permadie", "kind": "bool" },
          { "name": "MultiplierSet", "label": "Multiplier set", "kind": "int" },
          { "name": "CRAdjust", "label": "CR adjust", "kind": "int" }
        ]
      }
    ]
  },
  "pt": {
    "_label": "Party Table (party-wide state)",
    "_displayName": [],
    "sections": [
      {
        "title": "Party-wide state",
        "fields": [
          { "name": "PT_GOLD", "label": "Credits", "kind": "int", "min": 0, "max": 999999999,
            "help": "Party credits. UI breaks past ~1 billion." },
          { "name": "PT_XP_POOL", "label": "XP pool", "kind": "int", "min": 0, "max": 9999999,
            "help": "Unspent XP waiting for the next level-up." },
          { "name": "PT_PLAYEDSECONDS", "label": "Played time (seconds)", "kind": "int", "min": 0, "max": 999999999 },
          { "name": "PT_NUM_MEMBERS", "label": "Party member count", "kind": "int", "min": 1, "max": 3,
            "help": "PC + up to 2 companions. Don't exceed 3." },
          { "name": "PT_SOLOMODE", "label": "Solo mode", "kind": "bool" },
          { "name": "PT_CHEAT_USED", "label": "Cheats used (achievement flag)", "kind": "bool",
            "help": "Set by the game whenever you use a cheat. Flip back to 0 to undo." },
          { "name": "PT_CONTROLLED_NP", "label": "Controlled NPC index", "kind": "int" },
          { "name": "PT_MEMBERS", "label": "Party members", "kind": "list" },
          { "name": "PT_AVAIL_NPCS", "label": "Available NPCs", "kind": "list",
            "help": "Each entry has PT_NPC_AVAIL (available?) and PT_NPC_SELECT (selectable?)." },
          { "name": "JNL_Entries", "label": "Journal entries", "kind": "list" }
        ]
      }
    ]
  },
  "gvt": {
    "_label": "Globals (plot flags)",
    "_displayName": [],
    "sections": [
      {
        "title": "Global variables",
        "fields": [
          { "name": "CatBoolean", "label": "Boolean flag names", "kind": "list" },
          { "name": "CatNumber", "label": "Number flag names", "kind": "list" },
          { "name": "CatLocation", "label": "Location flag names", "kind": "list" },
          { "name": "CatString", "label": "String flag names", "kind": "list" },
          { "name": "ValBoolean", "label": "Boolean values (packed)", "kind": "void",
            "help": "Plot flags packed as bits. Edit in Advanced — risky." },
          { "name": "ValNumber", "label": "Number values", "kind": "void" },
          { "name": "ValString", "label": "String values", "kind": "list" }
        ]
      }
    ]
  },
  "nfo": {
    "_label": "Save info",
    "_displayName": ["SAVEGAMENAME", "AREANAME"],
    "sections": [
      {
        "title": "Save metadata",
        "fields": [
          { "name": "SAVEGAMENAME", "label": "Save name", "kind": "locstring" },
          { "name": "AREANAME", "label": "Area display name", "kind": "string" },
          { "name": "LASTMODULE", "label": "Last module", "kind": "string" },
          { "name": "TIMEPLAYED", "label": "Time played (seconds)", "kind": "int" },
          { "name": "CHEATUSED", "label": "Cheats used flag", "kind": "bool" },
          { "name": "PORTRAIT0", "label": "PC portrait resref", "kind": "string" },
          { "name": "PORTRAIT1", "label": "Companion 1 portrait", "kind": "string" }
        ]
      }
    ]
  },
  "bic": {
    "_label": "Player character",
    "_displayName": ["FirstName", "LastName"],
    "sections": [
      {
        "title": "Identity",
