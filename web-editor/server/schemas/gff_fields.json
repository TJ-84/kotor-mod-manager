          { "name": "FirstName", "label": "First name", "kind": "locstring" },
          { "name": "LastName", "label": "Last name", "kind": "locstring" },
          { "name": "Tag", "label": "Tag", "kind": "string" }
        ]
      },
      {
        "title": "Attributes",
        "fields": [
          { "name": "Str", "label": "Strength", "kind": "int", "min": 3, "max": 50,
            "help": "Vanilla cap is around 25 (with buffs); 50 is the engine ceiling." },
          { "name": "Dex", "label": "Dexterity", "kind": "int", "min": 3, "max": 50 },
          { "name": "Con", "label": "Constitution", "kind": "int", "min": 3, "max": 50 },
          { "name": "Int", "label": "Intelligence", "kind": "int", "min": 3, "max": 50 },
          { "name": "Wis", "label": "Wisdom", "kind": "int", "min": 3, "max": 50 },
          { "name": "Cha", "label": "Charisma", "kind": "int", "min": 3, "max": 50 }
        ]
      },
      {
        "title": "Hit Points & Force",
        "fields": [
          { "name": "HitPoints", "label": "Base HP", "kind": "int", "min": 0, "max": 9999 },
          { "name": "MaxHitPoints", "label": "Max HP (effective)", "kind": "int", "min": 0, "max": 9999 },
          { "name": "CurrentHitPoints", "label": "Current HP", "kind": "int", "min": 0, "max": 9999,
            "help": "Field is a 16-bit signed integer — values above 32767 will corrupt the save." },
          { "name": "ForcePoints", "label": "Max Force Points", "kind": "int", "min": 0, "max": 9999 },
          { "name": "CurrentForce", "label": "Current Force Points", "kind": "int", "min": 0, "max": 9999 }
        ]
      },
      {
        "title": "Defenses",
        "fields": [
          { "name": "NaturalAC", "label": "Natural AC bonus", "kind": "int", "min": 0, "max": 50 },
          { "name": "fortbonus", "label": "Fortitude save bonus", "kind": "int", "min": -50, "max": 50 },
          { "name": "refbonus", "label": "Reflex save bonus", "kind": "int", "min": -50, "max": 50 },
          { "name": "willbonus", "label": "Will save bonus", "kind": "int", "min": -50, "max": 50 }
        ]
      },
      {
        "title": "Experience & Alignment",
        "fields": [
          { "name": "Experience", "label": "Experience (XP)", "kind": "int", "min": 0, "max": 9999999,
            "help": "Total XP earned. Level up triggers on next XP gain past the next-level threshold." },
          { "name": "GoodEvil", "label": "Alignment (Dark ↔ Light)", "kind": "int",
            "min": 0, "max": 100,
            "help": "0 = pure dark side, 50 = neutral, 100 = pure light side." }
        ]
      },
      {
        "title": "Advanced",
        "fields": [
          { "name": "Gold", "label": "Credits on this character", "kind": "int", "min": 0, "max": 999999999,
            "help": "For party-wide credits, edit PT_GOLD in PARTYTABLE.res instead." },
          { "name": "ClassList", "label": "Classes (multiclass)", "kind": "list",
